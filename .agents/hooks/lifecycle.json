{
  "schema_version": 1,
  "project": "xp-bots",
  "state_prefix": "xp-bots",
  "skills": {
    "orchestrator": "xp-bots-request-skill-orchestrator",
    "audit": "xp-bots-completion-audit",
    "gap": "xp-bots-skill-gap-detector",
    "governance": "xp-bots-maintain-agent-skills"
  },
  "rules_files": ["AGENTS.md", ".agents/PROJECT_RULES.md"],
  "selector": ".agents/skills/xp-bots-request-skill-orchestrator/scripts/select_skills.py",
  "routing_rules": ".agents/skills/xp-bots-request-skill-orchestrator/references/routing-rules.json",
  "routing_cases": ".agents/skills/xp-bots-request-skill-orchestrator/references/routing-cases.json",
  "snapshot_exclusions": [".git", ".local", ".code-review-graph", ".codex-artifact-work", ".venv", "venv",
                          "__pycache__", ".pytest_cache", ".ruff_cache", ".mypy_cache", "htmlcov", "node_modules",
                          "data/raw", "data/cache", "data/private", "runtime", "logs", "reports", "exports"],
  "corrective_pass_limit": 2,
  "inherit_max_useful_words": 15,
  "pointer_window_seconds": 1800,
  "duplicate_window_seconds": 20,
  "session_context_max_chars": 3600,
  "auxiliary_tools_session_start": ["claude", "codex", "copilot", "cline"],
  "tools": {
    "claude": {"format": "hook-specific", "events": ["session-start", "prompt", "post-tool", "subagent-start", "stop"],
               "inject_on_first_tool": false},
    "codex": {"format": "hook-specific", "events": ["session-start", "prompt", "subagent-start", "stop"],
              "inject_on_first_tool": false},
    "copilot": {"format": "flat", "events": ["session-start", "prompt", "post-tool", "subagent-start", "stop"],
                "inject_on_first_tool": true},
    "cline": {"format": "report", "events": ["prompt", "completion"], "inject_on_first_tool": false,
              "fast_gates_only": true}
  },
  "mode_aliases": {
    "claude-session-start": "session-start-claude",
    "claude-prompt": "prompt-claude",
    "claude-stop": "stop-claude"
  },
  "plan_tools": ["ExitPlanMode", "exit_plan_mode"],
  "edit_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit", "apply_patch", "edit", "create", "str_replace_editor",
                 "write_file", "editFiles", "createFile"],
  "notification_sources": ["system", "loop_wakeup", "schedule_wakeup", "poll_event"],
  "notification_markers": ["<task-notification", "<system-notification", "<bash-notification", "<system-reminder>",
                           "<webhook-payload", "<wake reason=", "[notification systeme]", "[system notification]"],
  "corrective_prefix": "[xp-bots:passe-corrective",
  "continuation_exact": ["ok", "oui", "go", "yes", "d'accord", "parfait", "super", "c'est bon", "je valide", "valide",
                         "continue", "continuer", "vas-y", "vas y", "poursuis", "on continue", "suite", "la suite",
                         "proceed", "next", "go ahead", "ok vas-y", "ok continue"],
  "continuation_prefixes": ["continue", "continuer", "poursuis", "poursuivre", "vas-y", "vas y", "implemente le plan",
                            "implementer le plan", "execute le plan", "applique le plan", "l'utilisateur a approuve",
                            "user has approved", "the user has approved", "user approved", "lance l'etape suivante",
                            "passe a l'etape suivante", "passe a la suite", "on continue", "go ahead", "proceed with"],
  "audit_markers": {"success": "[XP-BOTS-AUDIT:OK]", "blocked": "[XP-BOTS-AUDIT:BLOQUE]"},
  "audit_footer": {"header": "Pied d'audit XP-Bots",
                   "keys": ["completion", "impact", "verifications", "couverture_skills"]},
  "gate_budget_seconds": {"normal": 420, "fast": 30},
  "gate_files_cap": 60,
  "gates": [
    {"name": "json-strict", "fast": true, "indicative": false, "timeout": 20,
     "patterns": ["**/*.json"],
     "command": ["{python}", "-B", "{hooks}/gate_checks.py", "json", "{files}"]},
    {"name": "python-syntax", "fast": true, "indicative": false, "timeout": 20,
     "patterns": ["**/*.py"],
     "command": ["{python}", "-B", "{hooks}/gate_checks.py", "python", "{files}"]},
    {"name": "markdown-links", "fast": true, "indicative": false, "timeout": 20,
     "patterns": ["**/*.md"],
     "command": ["{python}", "-B", "{hooks}/gate_checks.py", "links", "{files}"]},
    {"name": "governance-contract", "fast": true, "indicative": false, "timeout": 25,
     "patterns": [".agents/**", ".claude/**", ".codex/**", ".github/hooks/**", ".clinerules/**", "AGENTS.md", "CLAUDE.md"],
     "command": ["{python}", "-B", "{skills}/xp-bots-maintain-agent-skills/scripts/validate_governance.py", "--quiet"]},
    {"name": "governance-suite", "fast": false, "indicative": false, "timeout": 240,
     "patterns": [".agents/hooks/**", ".agents/skills/*/scripts/**", ".agents/skills/xp-bots-request-skill-orchestrator/references/**",
                  ".agents/skill-gap-ledger.json", ".agents/agent-integrations.json"],
     "command": ["{python}", "-B", "{skills}/xp-bots-maintain-agent-skills/scripts/run_governance_suite.py", "--quiet"]},
    {"name": "technical-reference-suite", "fast": false, "indicative": true, "timeout": 120,
     "patterns": ["reference/technical.py", "tests/check_technical.py", "config/parametres_figes_v3.json"],
     "command": ["{python}", "-B", "tests/check_technical.py"]},
    {"name": "llm-contract-suite", "fast": false, "indicative": true, "timeout": 120,
     "patterns": ["reference/llm_contracts.py", "tests/check_llm.py", "config/parametres_IA_integration_v1.json",
                  "schemas/**", "prompts/**", "livrables/strategies_m15/01_Triple_EMA_RSI_Repli_M15_Specification_IA.md",
                  "livrables/strategies_m15/02_London_Breakout_M15_Specification_IA.md"],
     "command": ["{python}", "-B", "tests/check_llm.py"]},
    {"name": "project-verification", "fast": false, "indicative": true, "timeout": 240,
     "patterns": ["README.md", "docs/**", "livrables/strategies_m15/**", "config/**", "schemas/**", "prompts/**",
                  "reference/**", "tests/**", "tools/**", ".gitignore", ".gitattributes", ".env.example",
                  "requirements-dev.txt"],
     "command": ["{python}", "-B", "tools/verify_project.py"]}
  ],
  "skill_library": {
    "skills_dir": ".agents/skills",
    "catalog": ".agents/skills/xp-bots-request-skill-orchestrator/SKILL.md",
    "catalog_markers": ["<!-- catalogue:debut -->", "<!-- catalogue:fin -->"],
    "ledger": ".agents/skill-gap-ledger.json",
    "promotion_threshold": 2,
    "max_new_skills_per_request": 1,
    "domain_prefix": "xp-bots-",
    "validators": [
      ["{python}", "-B", "{hooks}/skill_mirrors.py", "--check"],
      ["{python}", "-B", "{skills}/xp-bots-maintain-agent-skills/scripts/validate_governance.py", "--quiet"],
      ["{python}", "-B", "{skills}/xp-bots-request-skill-orchestrator/scripts/select_skills.py", "--test"]
    ]
  }
}
