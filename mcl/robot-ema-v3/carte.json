  "unites": [
    {
      "id": "noyau",
      "responsabilite": "Fournir les types de couture, les ports, les motifs, le schéma C09 et le chargeur de configuration (squelette).",
      "depend_de": [],
      "couche": "0"
    },
    {
      "id": "donnees_temps",
      "responsabilite": "Produire les bougies enrichies et le contexte temporel (C03).",
      "depend_de": [
        "noyau"
      ],
      "couche": "1a"
    },
    {
      "id": "contexte_ia",
      "responsabilite": "Lire le snapshot IA et rendre BLOCK ou NEUTRAL (A07, A10, A12).",
      "depend_de": [
        "noyau",
        "execution"
      ],
      "couche": "1b"
    },
    {
      "id": "moteur_ema",
      "responsabilite": "Appliquer la méthode S01.",
      "depend_de": [
        "noyau",
        "donnees_temps"
      ],
      "couche": "2a"
    },
    {
      "id": "execution",
      "responsabilite": "Appliquer C06–C09 et coordonner le compte.",
      "depend_de": [
        "noyau",
        "donnees_temps"
      ],
      "couche": "2b"
    },
    {
      "id": "fondamental",
      "responsabilite": "Appliquer C05.",
      "depend_de": [
        "noyau",
        "execution"
      ],
      "couche": "2c"
    },
    {
      "id": "service_ia",
      "responsabilite": "Produire le snapshot IA (A04–A11).",
      "depend_de": [
        "noyau",
        "contexte_ia"
      ],
      "couche": "2d"
    },
    {
      "id": "journal_rejeu",
      "responsabilite": "Journaliser, rejouer et mesurer (C09, C10, A13).",
      "depend_de": [
        "noyau",
        "donnees_temps",
        "execution"
      ],
      "couche": "3"
    },
    {
      "id": "infrastructure",
      "responsabilite": "Implémenter les frontières externes réelles.",
      "depend_de": [
        "noyau",
        "donnees_temps",
        "execution",
        "fondamental",
        "contexte_ia",
        "journal_rejeu",
        "service_ia",
        "metatrader5",
        "sqlite",
        "reseau",
        "horloge-os"
      ],
      "couche": "4"
    },
    {
      "id": "app",
      "responsabilite": "Câbler les composants et exposer les points d'entrée.",
      "depend_de": [
        "noyau",
        "donnees_temps",
        "contexte_ia",
        "moteur_ema",
        "execution",
        "fondamental",
        "service_ia",
        "journal_rejeu",
        "infrastructure",
        "horloge-os"
      ],
      "couche": "5"
    }
  ],
