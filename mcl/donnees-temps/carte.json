  "unites": [
    {
      "id": "parametres_techniques",
      "responsabilite": "Charger et valider le bloc common de la configuration figée en objet immuable, avec l'empreinte canonique du bundle.",
      "depend_de": [
        "amont-noyau"
      ],
      "couche": "0"
    },
    {
      "id": "calendrier_seances",
      "responsabilite": "Représenter les séances de cotation natives d'un symbole et dire si un instant est en séance.",
      "depend_de": [
        "amont-noyau"
      ],
      "couche": "0"
    },
    {
      "id": "sessions_londres",
      "responsabilite": "Calculer jours Londres et UTC, appartenance aux fenêtres de méthode, heures locales de sortie et blackout de rollover via Europe/London.",
      "depend_de": [
        "parametres_techniques"
      ],
      "couche": "1a"
    },
    {
      "id": "constructeur_bougies",
      "responsabilite": "Agréger les ticks en bougies M15/H1 Bid clôturées sur [T,T+d) aligné UTC et signaler les trous.",
      "depend_de": [
        "parametres_techniques",
        "calendrier_seances",
        "amont-noyau"
      ],
      "couche": "1b"
    },
    {
      "id": "indicateurs",
      "responsabilite": "Calculer de façon incrémentale EMA graine SMA, RSI et ATR Wilder, TR et A_t = ATR de t−1.",
      "depend_de": [
        "parametres_techniques"
      ],
      "couche": "1c"
    },
    {
      "id": "etat_indicateurs",
      "responsabilite": "Précharger, persister et restaurer les états récursifs par symbole et en tracer l'empreinte.",
      "depend_de": [
        "indicateurs",
        "stockage-etat",
        "amont-noyau"
      ],
      "couche": "2"
    },
    {
      "id": "pipeline_marche",
      "responsabilite": "Produire par symbole les bougies enrichies et les événements de trou à partir des ticks, de la couverture et de l'horloge.",
      "depend_de": [
        "sessions_londres",
        "constructeur_bougies",
        "etat_indicateurs"
      ],
      "couche": "3"
    }
  ],
  "externes": [
