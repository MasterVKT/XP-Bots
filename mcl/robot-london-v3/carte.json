  "unites": [
    {
      "id": "noyau",
      "responsabilite": "Fournir les types et règles partagés (temps, nombres, configuration figée, marché, instrument, domaine, journal).",
      "depend_de": [],
      "couche": "0"
    },
    {
      "id": "london-donnees-temps",
      "responsabilite": "Construire les bougies M15 et H1 causales, validées et enrichies d'indicateurs à partir des ticks (C03).",
      "depend_de": [
        "noyau"
      ],
      "couche": "1"
    },
    {
      "id": "moteur-london",
      "responsabilite": "Appliquer la méthode S02 de façon pure et indépendante, des bougies aux signaux techniques.",
      "depend_de": [
        "noyau",
        "london-donnees-temps"
      ],
      "couche": "2a"
    },
    {
      "id": "execution-coordinateur",
      "responsabilite": "Transformer un signal en ordre protégé dimensionné et coordonner risque, marge et positions du compte partagé (C06 à C08).",
      "depend_de": [
        "noyau",
        "london-donnees-temps"
      ],
      "couche": "2b"
    },
    {
      "id": "controles-fondamentaux",
      "responsabilite": "Évaluer les permissions fondamentales externes et la garde d'annonces (C05).",
      "depend_de": [
        "noyau",
        "execution-coordinateur"
      ],
      "couche": "3a"
    },
    {
      "id": "contexte-ia",
      "responsabilite": "Lire le snapshot IA, tenir le cache des vetos et rendre BLOCK ou NEUTRAL (A07, A10, A12).",
      "depend_de": [
        "noyau",
        "execution-coordinateur"
      ],
      "couche": "3b"
    },
    {
      "id": "infrastructure",
      "responsabilite": "Implémenter les seules frontières réelles : MT5, fichiers, SQLite, horloge, journaux, dossier d'échange et exports MQL5.",
      "depend_de": [
        "noyau",
        "execution-coordinateur",
        "MetaTrader5",
        "sqlite3",
        "fichiers",
        "horloge",
        "threading"
      ],
      "couche": "3c"
    },
    {
      "id": "orchestration",
      "responsabilite": "Ordonner les événements dans le moteur de décision unique, avec bras A/B et stratégies injectées (C08, D-18).",
      "depend_de": [
        "noyau",
        "london-donnees-temps",
        "execution-coordinateur",
        "controles-fondamentaux",
        "contexte-ia"
      ],
      "couche": "4a"
    },
    {
      "id": "service-ia",
      "responsabilite": "Collecter les textes officiels, interroger les API autorisées sous budget et publier le snapshot IA (A04 à A11).",
      "depend_de": [
        "noyau",
        "contexte-ia",
        "sqlite3",
        "reseau",
        "fichiers",
        "horloge",
        "threading"
      ],
      "couche": "4b"
    },
    {
      "id": "journal-rejeu",
      "responsabilite": "Simuler l'exécution C10, rejouer les ticks, calculer métriques, bootstrap et rapports.",
      "depend_de": [
        "noyau",
        "execution-coordinateur",
        "orchestration",
        "moteur-london",
        "aleatoire",
        "controles-fondamentaux",
        "contexte-ia"
      ],
      "couche": "5"
    },
    {
      "id": "points-entree",
      "responsabilite": "Composer le robot, le rejeu, la qualification et les rapports en commandes exécutables.",
      "depend_de": [
        "noyau",
        "orchestration",
        "journal-rejeu",
        "infrastructure",
        "moteur-london",
        "execution-coordinateur",
        "controles-fondamentaux",
        "contexte-ia"
      ],
      "couche": "6"
    }
