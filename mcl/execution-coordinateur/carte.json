        "types_execution"
      ],
      "couche": "1b"
    },
    {
      "id": "gardes_compte",
      "responsabilite": "Suivre base quotidienne UTC et pic de fonds propres et imposer les arrêts quotidien et global persistants.",
      "depend_de": [
        "types_execution",
        "stockage-etat"
      ],
      "couche": "1c"
    },
    {
      "id": "registre_reservations",
      "responsabilite": "Réserver et libérer le risque initial de façon atomique et persistante par clé d'intention.",
      "depend_de": [
        "types_execution",
        "stockage-etat"
      ],
      "couche": "1d"
    },
    {
      "id": "risque_all_in",
