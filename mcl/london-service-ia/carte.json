  "unites": [
    {
      "id": "types",
      "responsabilite": "Définir les ressources IA immuables, documents, jobs, réponses et ports externes.",
      "depend_de": [
        "amont-noyau",
        "amont-contexte"
      ],
      "couche": "0"
    },
    {
      "id": "tokens",
      "responsabilite": "Borner le corps complet hors secret et réduire seulement des passages cohérents.",
      "depend_de": [
        "types"
      ],
      "couche": "1a"
    },
    {
      "id": "validation",
      "responsabilite": "Valider strictement extraction et notes selon les schémas exportés.",
      "depend_de": [
        "types"
      ],
      "couche": "1b"
    },
    {
      "id": "normalisation",
      "responsabilite": "Nettoyer les flux officiels et préserver identité, provenance et première connaissance.",
      "depend_de": [
        "types"
      ],
      "couche": "1c"
    },
    {
      "id": "budget",
      "responsabilite": "Admettre et rapprocher coûts, quotas et réservations dans une transaction injectée.",
      "depend_de": [
        "types",
        "stockage"
      ],
      "couche": "1d"
    },
    {
      "id": "fournisseurs",
      "responsabilite": "Construire les requêtes A08 et décoder leurs réponses sans transport implicite.",
      "depend_de": [
        "types"
      ],
      "couche": "1e"
    },
    {
      "id": "snapshot",
      "responsabilite": "Former les snapshots A10 avec séquence persistée et validation du lecteur réel.",
      "depend_de": [
        "types",
        "amont-contexte",
        "stockage",
        "fichiers"
      ],
      "couche": "1f"
    },
    {
      "id": "veto",
      "responsabilite": "Construire le seul veto A06 après validation et appariement causal du calendrier.",
      "depend_de": [
        "types",
        "validation",
        "amont-fondamental",
        "amont-contexte",
        "amont-noyau"
      ],
      "couche": "2a"
    },
    {
      "id": "routeur",
      "responsabilite": "Router les jobs dans les délais, quotas et allowlists A08–A09.",
      "depend_de": [
        "types",
        "tokens",
        "validation",
        "budget",
        "fournisseurs",
        "stockage",
        "transport",
        "temps-et-workers"
      ],
      "couche": "2b"
    },
    {
      "id": "collecteur",
      "responsabilite": "Collecter par port HTTP conditionnel, avec redirections et reprises bornées.",
      "depend_de": [
        "types",
        "normalisation",
        "stockage",
        "transport",
        "temps-et-workers"
      ],
      "couche": "2c"
    },
    {
      "id": "planificateur",
      "responsabilite": "Planifier, dédupliquer et archiver extraction, notes et surveillance de dérive.",
      "depend_de": [
        "types",
        "veto",
        "routeur",
        "collecteur",
        "stockage",
        "temps-et-workers",
        "validation",
        "amont-noyau",
        "budget"
      ],
      "couche": "3"
    },
    {
      "id": "service",
