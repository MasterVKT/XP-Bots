  "unites": [
    {
      "id": "parametres_ia",
      "responsabilite": "Charger l'export IA, les schémas et les prompts exacts.",
      "depend_de": [
        "amont-noyau"
      ],
      "couche": "0"
    },
    {
      "id": "normalisation_textes",
      "responsabilite": "Normaliser et dédoublonner les textes officiels collectés.",
      "depend_de": [
        "parametres_ia"
      ],
      "couche": "1a"
    },
    {
      "id": "borne_tokens",
      "responsabilite": "Calculer la borne conservatrice de tokens d'une requête.",
      "depend_de": [
        "parametres_ia"
      ],
      "couche": "1b"
    },
    {
      "id": "validateurs_sorties",
      "responsabilite": "Valider strictement les sorties d'extraction et informatives.",
      "depend_de": [
        "parametres_ia"
      ],
      "couche": "1c"
    },
    {
      "id": "registre_budget",
      "responsabilite": "Réserver et rapprocher coûts, tentatives et tokens de façon transactionnelle.",
      "depend_de": [
        "parametres_ia",
        "stockage-ia"
      ],
      "couche": "1d"
    },
    {
      "id": "evenement_veto",
      "responsabilite": "Construire un événement OFFICIAL_UNSCHEDULED_POLICY selon A06.",
      "depend_de": [
        "validateurs_sorties",
        "normalisation_textes",
        "amont-contexte-ia"
      ],
      "couche": "2a"
    },
    {
      "id": "routeur_fournisseurs",
      "responsabilite": "Choisir et appeler les fournisseurs dans l'ordre et les délais A08.",
      "depend_de": [
        "borne_tokens",
        "registre_budget",
        "validateurs_sorties",
        "transport-llm"
      ],
      "couche": "2b"
    },
    {
      "id": "ecrivain_snapshot",
      "responsabilite": "Publier atomiquement le snapshot et son heartbeat.",
      "depend_de": [
        "evenement_veto",
        "ipc-ecriture"
      ],
      "couche": "3a"
    },
    {
      "id": "planificateur",
      "responsabilite": "Planifier collectes, classifications, briefings, journaux et revues.",
      "depend_de": [
        "routeur_fournisseurs",
        "normalisation_textes",
        "collecte-rss"
      ],
      "couche": "3b"
    },
    {
      "id": "service",
      "responsabilite": "Exécuter le service : collecteur, worker unique, heartbeat.",
      "depend_de": [
        "planificateur",
        "ecrivain_snapshot"
      ],
      "couche": "4"
    }
  ],
